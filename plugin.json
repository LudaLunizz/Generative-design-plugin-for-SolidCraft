{
  "id": "gen-design-engine",
  "name": "Generative Design Engine",
  "version": "0.6.0",
  "description": "Engineering material library (sourced cards), material report, a 2D stress check of flat parts with safety factor, and a plate optimiser (sketch + extrude). Third-party plugin, not affiliated with SolidCraft.",
  "capabilities": [
    "commands@0.1"
  ],
  "runtime": {
    "module": "plugin.wasm",
    "entries": [
      {"name":"apply-material","effect":"edit","slots":[{"kind":"ribbon","name":"Manage"}],"input_schema":{"type":"object","required":["material"],"properties":{"material":{"type":"string","title":"Material","default":"aluminium-6061-t6","oneOf":[{"const":"aluminium-6061-t6","title":"Aluminium 6061-T6"},{"const":"aluminium-7075-t6","title":"Aluminium 7075-T6"},{"const":"aluminium-5083-h111","title":"Aluminium 5083-H111"},{"const":"steel-s235jr","title":"Steel S235JR"},{"const":"steel-s355jr","title":"Steel S355JR"},{"const":"stainless-304","title":"Stainless steel 304"},{"const":"stainless-316l","title":"Stainless steel 316L"},{"const":"titanium-ti6al4v","title":"Titanium Ti-6Al-4V"},{"const":"pla-printed","title":"PLA (3D printed, generic)"},{"const":"petg-printed","title":"PETG (3D printed, generic)"},{"const":"abs-printed","title":"ABS (3D printed, generic)"},{"const":"asa-printed","title":"ASA (3D printed, Bambu Lab)"},{"const":"paht-cf-printed","title":"PAHT-CF (3D printed, Bambu Lab)"},{"const":"pa12-sls","title":"Nylon PA12 (SLS printed, generic)"}],"description":"Creates this material with its engineering card in the design (once) and assigns it"},"body":{"type":"string","title":"Body","default":"","description":"A body name; empty means every body in the design (scripts may pass a bodies list instead)"}}}},
      {"name":"material-report","effect":"read","slots":[{"kind":"ribbon","name":"Inspect"}],"input_schema":{"type":"object","properties":{"body":{"type":"string","title":"Body","default":"","description":"A body name; empty means every body in the design (scripts may pass a bodies list instead)"},"safety_factor":{"type":"number","title":"Safety factor","default":2.0,"minimum":1.0,"maximum":10.0,"description":"Allowable stress = yield strength (or tensile strength when there is no yield) / safety factor"}}}},
      {"name":"materials","effect":"read","slots":[{"kind":"ribbon","name":"Manage"}],"input_schema":{"type":"object","properties":{"family":{"type":"string","title":"Family","default":"any","oneOf":[{"const":"any","title":"All materials"},{"const":"metal","title":"Metals"},{"const":"polymer","title":"Plastics"}]},"safety_factor":{"type":"number","title":"Safety factor","default":2.0,"minimum":1.0,"maximum":10.0,"description":"Allowable stress = yield strength (or tensile strength when there is no yield) / safety factor"}}}},
      {"name":"stress-check","effect":"read","slots":[{"kind":"ribbon","name":"Inspect"}],"input_schema":{"type":"object","required":["fixed","load"],"properties":{"fixed":{"type":"string","title":"Fixed faces","description":"Where the part is held: a face name (F1:-x, F2:bore:side:0), its number, or a side (-x, +y ...); several with commas"},"load":{"type":"string","title":"Load faces","description":"Where the force acts, as for Fixed faces; the force is spread evenly over them"},"force_x":{"type":"number","title":"Force X","unit":"N","default":0},"force_y":{"type":"number","title":"Force Y","unit":"N","default":-100},"force_z":{"type":"number","title":"Force Z","unit":"N","default":0},"body":{"type":"string","title":"Body","default":"","description":"The body to check; empty when the design has one body"},"material":{"type":"string","title":"Material","default":"body","oneOf":[{"const":"body","title":"The body's own material"},{"const":"aluminium-6061-t6","title":"Aluminium 6061-T6"},{"const":"aluminium-7075-t6","title":"Aluminium 7075-T6"},{"const":"aluminium-5083-h111","title":"Aluminium 5083-H111"},{"const":"steel-s235jr","title":"Steel S235JR"},{"const":"steel-s355jr","title":"Steel S355JR"},{"const":"stainless-304","title":"Stainless steel 304"},{"const":"stainless-316l","title":"Stainless steel 316L"},{"const":"titanium-ti6al4v","title":"Titanium Ti-6Al-4V"},{"const":"pla-printed","title":"PLA (3D printed, generic)"},{"const":"petg-printed","title":"PETG (3D printed, generic)"},{"const":"abs-printed","title":"ABS (3D printed, generic)"},{"const":"asa-printed","title":"ASA (3D printed, Bambu Lab)"},{"const":"paht-cf-printed","title":"PAHT-CF (3D printed, Bambu Lab)"},{"const":"pa12-sls","title":"Nylon PA12 (SLS printed, generic)"}]},"safety_factor":{"type":"number","title":"Safety factor needed","default":2.0,"minimum":1.0,"maximum":10.0},"plane":{"type":"string","title":"Plate plane","default":"auto","oneOf":[{"const":"auto","title":"Automatic (across the thinnest direction)"},{"const":"xy","title":"XY (thickness along Z)"},{"const":"xz","title":"XZ (thickness along Y)"},{"const":"yz","title":"YZ (thickness along X)"}]},"resolution":{"type":"integer","title":"Cells along the longer side","default":240,"minimum":10,"maximum":400},"picture":{"type":"boolean","title":"Text heat map","default":true}}}},
      {"name":"optimise-plate","effect":"edit","slots":[{"kind":"ribbon","name":"Manage"}],"input_schema":{"type":"object","properties":{"width_mm":{"type":"number","title":"Width","unit":"mm","default":200,"minimum":1,"maximum":10000,"description":"Along X; the fixed edge is at X = 0"},"height_mm":{"type":"number","title":"Height","unit":"mm","default":100,"minimum":1,"maximum":10000,"description":"Along Y; rounded to whole grid cells"},"thickness_mm":{"type":"number","title":"Thickness","unit":"mm","default":10,"minimum":0.1,"maximum":1000},"material":{"type":"string","title":"Material","default":"aluminium-6061-t6","oneOf":[{"const":"aluminium-6061-t6","title":"Aluminium 6061-T6"},{"const":"aluminium-7075-t6","title":"Aluminium 7075-T6"},{"const":"aluminium-5083-h111","title":"Aluminium 5083-H111"},{"const":"steel-s235jr","title":"Steel S235JR"},{"const":"steel-s355jr","title":"Steel S355JR"},{"const":"stainless-304","title":"Stainless steel 304"},{"const":"stainless-316l","title":"Stainless steel 316L"},{"const":"titanium-ti6al4v","title":"Titanium Ti-6Al-4V"},{"const":"pla-printed","title":"PLA (3D printed, generic)"},{"const":"petg-printed","title":"PETG (3D printed, generic)"},{"const":"abs-printed","title":"ABS (3D printed, generic)"},{"const":"asa-printed","title":"ASA (3D printed, Bambu Lab)"},{"const":"paht-cf-printed","title":"PAHT-CF (3D printed, Bambu Lab)"},{"const":"pa12-sls","title":"Nylon PA12 (SLS printed, generic)"}]},"load_case":{"type":"string","title":"Load case","default":"cantilever","oneOf":[{"const":"cantilever","title":"Cantilever (left edge fixed, load at right middle)"},{"const":"mbb","title":"MBB half beam (symmetric, load at top left)"}]},"force_n":{"type":"number","title":"Force","unit":"N","default":500,"minimum":0.001,"maximum":1000000000,"description":"Used for the deflection estimate only; the shape does not depend on it"},"volume_share":{"type":"number","title":"Material share","default":0.4,"minimum":0.1,"maximum":0.9},"cells":{"type":"integer","title":"Cells across the width","default":80,"minimum":20,"maximum":240,"description":"More cells give finer detail and take longer; rounded to a multiple of 4; the whole grid is capped at 30000 cells"},"iterations":{"type":"integer","title":"Design iterations","default":60,"minimum":10,"maximum":150},"filter_radius":{"type":"number","title":"Smallest member (cells)","default":2,"minimum":1,"maximum":4},"round_mm":{"type":"number","title":"Corner rounding","unit":"mm","default":0,"minimum":0,"maximum":10000,"description":"Fillet radius where members meet (0 = none); adds a little material, never thins a member"},"name":{"type":"string","title":"Body name","default":"Optimised plate"}}}},
      {"name":"solver-benchmark","effect":"read","input_schema":{"type":"object","properties":{"nx":{"type":"integer","title":"Cells along X","default":60,"minimum":2,"maximum":2000},"ny":{"type":"integer","title":"Cells along Y","default":30,"minimum":2,"maximum":2000},"iterations":{"type":"integer","title":"Design iterations","default":50,"minimum":1,"maximum":1000},"load":{"type":"string","title":"Test case","default":"cantilever","oneOf":[{"const":"cantilever","title":"Cantilever (left edge fixed, load at right middle)"},{"const":"mbb","title":"MBB beam (half, symmetric)"}]},"volfrac":{"type":"number","title":"Material share","default":0.5,"minimum":0.05,"maximum":0.95},"rmin":{"type":"number","title":"Filter radius (cells)","default":1.5,"minimum":1,"maximum":10},"cg_tol":{"type":"number","title":"Solver tolerance","default":1e-06,"minimum":1e-12,"maximum":0.1},"cg_max":{"type":"integer","title":"Solver step limit","default":20000,"minimum":1,"maximum":100000},"solver":{"type":"string","title":"Solver","default":"multigrid","oneOf":[{"const":"multigrid","title":"Multigrid (fast)"},{"const":"jacobi","title":"Jacobi (simple, for comparison)"}]},"picture":{"type":"boolean","title":"Text picture of the result","default":true}}}}
    ],
    "commands": [
      "document.inspect",
      "inspect.measure",
      "material.assign",
      "material.create",
      "material.list",
      "model.faces",
      "model.mesh",
      "sketch.create",
      "sketch.finish",
      "sketch.line",
      "sketch.spline.fit_point",
      "solid.extrude"
    ],
    "limits": {
      "fuel": 100000000000,
      "memory_mib": 64,
      "deadline_ms": 30000
    }
  }
}
